{
  "name": "exemplara-svelte",
  "version": "0.2.1",
  "description": "Native drag-and-drop builder for responsive websites and print-first PDF templates — Svelte 5",
  "license": "MIT",
  "author": "Ivaylo Bosev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibosev/exemplara-svelte.git"
  },
  "bugs": {
    "url": "https://github.com/ibosev/exemplara-svelte/issues"
  },
  "homepage": "https://github.com/ibosev/exemplara-svelte#readme",
  "keywords": [
    "svelte",
    "svelte5",
    "editor",
    "page-builder",
    "pdf",
    "print",
    "templates",
    "drag-and-drop"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./editor": {
      "types": "./dist/editor/index.d.ts",
      "svelte": "./dist/editor/index.js",
      "import": "./dist/editor/index.js"
    },
    "./editor/composable": {
      "types": "./dist/editor/ComposableEditor.svelte.d.ts",
      "svelte": "./dist/editor/ComposableEditor.svelte",
      "import": "./dist/editor/ComposableEditor.svelte"
    },
    "./editor/composition": {
      "types": "./dist/editor/composition.d.ts",
      "import": "./dist/editor/composition.js"
    },
    "./plugins/*": {
      "types": "./dist/editor/plugins/*.d.ts",
      "svelte": "./dist/editor/plugins/*.js",
      "import": "./dist/editor/plugins/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "svelte-package -i src/lib -o dist",
    "package": "svelte-package -i src/lib -o dist",
    "test": "vitest",
    "test:run": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "clean": "rm -rf dist",
    "test:packages": "node scripts/certify-packages.mjs",
    "test:browser": "node scripts/certify-browser.mjs",
    "check:state": "node scripts/check-state-ownership.mjs"
  },
  "devDependencies": {
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "playwright-core": "^1.63.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "svelte": "^5.29.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.51.0",
    "exemplara-core": "^0.1.0"
  },
  "pnpm": {
    "overrides": {
      "exemplara-core": "link:../exemplara-core"
    }
  }
}
